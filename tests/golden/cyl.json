{
  "gpu": {
    "error": false,
    "eval": {
      "argv": [
        "<RUN>/task/eval.py",
        "--worker-eval",
        "<RUN>/blocks/b01/b01_dump.py",
        "<TMP>/params.pkl"
      ],
      "cwd": "<RUN>",
      "env": {
        "FORGE_TASK": "cyl",
        "FORGE_TASK_DIR": "<RUN>/task",
        "FORGE_WALL_BUDGET": "3600",
        "JAX_PLATFORMS": "cpu",
        "XLA_PYTHON_CLIENT_PREALLOCATE": "false"
      },
      "path0": "<RUN>/task"
    },
    "rRMSE": 1.0,
    "record_keys": [
      "ts",
      "block",
      "candidate",
      "seed",
      "gpu",
      "smoke",
      "rRMSE",
      "step_count",
      "train_s",
      "wall_s",
      "params",
      "error",
      "wall_budget"
    ],
    "train": {
      "argv": [
        "<RUN>/task/eval.py",
        "--worker-train",
        "<RUN>/blocks/b01/b01_dump.py",
        "0",
        "<TMP>/params.pkl"
      ],
      "cwd": "<RUN>",
      "env": {
        "CUDA_VISIBLE_DEVICES": "0",
        "FORGE_EVAL_TOKEN": "task/eval.py",
        "FORGE_TASK": "cyl",
        "FORGE_TASK_DIR": "<RUN>/task",
        "FORGE_WALL_BUDGET": "3600",
        "XLA_PYTHON_CLIENT_PREALLOCATE": "false"
      },
      "path0": "<RUN>/task"
    }
  },
  "smoke": {
    "error": false,
    "eval": {
      "argv": [
        "<RUN>/task/eval.py",
        "--worker-eval",
        "<RUN>/blocks/b01/b01_dump.py",
        "<TMP>/params.pkl"
      ],
      "cwd": "<RUN>",
      "env": {
        "FORGE_TASK": "cyl",
        "FORGE_TASK_DIR": "<RUN>/task",
        "FORGE_WALL_BUDGET": "3600",
        "JAX_PLATFORMS": "cpu",
        "XLA_PYTHON_CLIENT_PREALLOCATE": "false"
      },
      "path0": "<RUN>/task"
    },
    "rRMSE": 1.0,
    "record_keys": [
      "ts",
      "block",
      "candidate",
      "seed",
      "gpu",
      "smoke",
      "rRMSE",
      "step_count",
      "train_s",
      "wall_s",
      "params",
      "error",
      "wall_budget"
    ],
    "train": {
      "argv": [
        "<RUN>/task/eval.py",
        "--worker-train",
        "<TMP>/candidate_smoke.py",
        "0",
        "<TMP>/params.pkl"
      ],
      "cwd": "<RUN>",
      "env": {
        "FORGE_EVAL_TOKEN": "task/eval.py",
        "FORGE_TASK": "cyl",
        "FORGE_TASK_DIR": "<RUN>/task",
        "FORGE_WALL_BUDGET": "3600",
        "JAX_PLATFORMS": "cpu",
        "XLA_PYTHON_CLIENT_PREALLOCATE": "false"
      },
      "path0": "<RUN>/task"
    }
  }
}
