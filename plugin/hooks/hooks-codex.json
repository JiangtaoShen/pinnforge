{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/session-start.py\" || python \"${PLUGIN_ROOT}/hooks/session-start.py\" || py -3 \"${PLUGIN_ROOT}/hooks/session-start.py\""
          }
        ]
      }
    ]
  }
}
